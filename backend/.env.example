# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas standard connection string recommended on Windows)
# Local example:
# MONGODB_URI=mongodb://127.0.0.1:27017/store
# Atlas example:
MONGODB_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/store?ssl=true&replicaSet=YOUR_REPLICA_SET&authSource=admin

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# CORS — comma-separated list of allowed frontend origins
# Local Vite:
CORS_ORIGIN=https://react-redux-ecom-git-development-serines-projects-d96bdd29.vercel.app/
# Production example (after you deploy the frontend):
# CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173

# OAuth2 / OpenID Connect (optional demo endpoint)
OAUTH_ISSUER_BASE_URL=https://YOUR_TENANT.us.auth0.com/
OAUTH_AUDIENCE=https://virestis-api
