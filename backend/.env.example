# Server
PORT=5000

# MongoDB connection string.
# Local MongoDB Community Server example:
MONGODB_URI=mongodb://127.0.0.1:27017/virestis
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/virestis

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# CORS - the origin of the React dev server (see TD-TP 2)
CORS_ORIGIN=http://localhost:5173

# OAuth2 / OpenID Connect resource-server config, used only by the
# /api/secure/oauth demo endpoint (see README "OAuth2 testing" section).
# Point these at any standards-compliant provider you configure (Auth0, Okta, etc.)
OAUTH_ISSUER_BASE_URL=https://YOUR_TENANT.us.auth0.com/
OAUTH_AUDIENCE=https://virestis-api
